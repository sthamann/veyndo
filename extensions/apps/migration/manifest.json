{
  "id": "migration",
  "version": "0.1.0",
  "coreApi": "1",
  "runtime": "service",
  "category": "operations",
  "name": {
    "en": "Migration Assistant",
    "de": "Migrationsassistent",
    "fr": "Assistant de migration",
    "es": "Asistente de migración"
  },
  "permissions": [
    "service.call",
    "admin.slot",
    "jobs.write",
    "products.write",
    "customers.write",
    "customers.pii",
    "orders.read",
    "orders.import",
    "settings.read",
    "events:self",
    "data.write",
    "assets.write",
    "reviews.write",
    "promotions.write"
  ],
  "settings": [
    {
      "key": "system",
      "kind": "string",
      "required": true,
      "label": {
        "en": "Source system: shopify / woocommerce / prestashop / magento2 / shopware5",
        "de": "Quellsystem: shopify / woocommerce / prestashop / magento2 / shopware5",
        "fr": "Système source : shopify / woocommerce / prestashop / magento2 / shopware5",
        "es": "Sistema origen: shopify / woocommerce / prestashop / magento2 / shopware5"
      }
    },
    {
      "key": "origin",
      "kind": "string",
      "required": true,
      "label": {
        "en": "Source shop HTTPS URL",
        "de": "HTTPS-Adresse des Quellshops",
        "fr": "URL HTTPS de la boutique source",
        "es": "URL HTTPS de la tienda origen"
      }
    },
    {
      "key": "version",
      "kind": "string",
      "required": true,
      "label": {
        "en": "Source API version",
        "de": "API-Version der Quelle",
        "fr": "Version API source",
        "es": "Versión API origen"
      }
    },
    {
      "key": "token",
      "kind": "secret",
      "required": true,
      "label": {
        "en": "Source read credential",
        "de": "Lesezugang der Quelle",
        "fr": "Identifiant de lecture source",
        "es": "Credencial de lectura origen"
      }
    },
    {
      "key": "username",
      "kind": "string",
      "required": false,
      "label": {
        "en": "API username / consumer key",
        "de": "API-Benutzername / Consumer Key",
        "fr": "Utilisateur API / clé consommateur",
        "es": "Usuario API / clave consumidor"
      }
    },
    {
      "key": "currency",
      "kind": "string",
      "required": true,
      "label": {
        "en": "Source currency, for example EUR",
        "de": "Quellwährung, zum Beispiel EUR",
        "fr": "Devise source, par exemple EUR",
        "es": "Moneda origen, por ejemplo EUR"
      }
    },
    {
      "key": "scale",
      "kind": "integer",
      "required": true,
      "label": {
        "en": "Currency decimals, for example 2 for EUR",
        "de": "Währungsnachkommastellen, zum Beispiel 2 für EUR",
        "fr": "Décimales, par exemple 2 pour EUR",
        "es": "Decimales, por ejemplo 2 para EUR"
      }
    },
    {
      "key": "locale",
      "kind": "string",
      "required": true,
      "label": {
        "en": "Source content locale, for example de-DE",
        "de": "Inhaltssprache der Quelle, zum Beispiel de-DE",
        "fr": "Langue source, par exemple de-DE",
        "es": "Idioma origen, por ejemplo de-DE"
      }
    },
    {
      "key": "language_map",
      "kind": "string",
      "required": false,
      "label": {
        "en": "Source language mapping",
        "de": "Sprachzuordnung der Quelle",
        "fr": "Mappage des langues source",
        "es": "Mapeo de idiomas origen"
      }
    },
    {
      "key": "timezone",
      "kind": "string",
      "required": false,
      "label": {
        "en": "Source timezone (IANA, for example Europe/Berlin)",
        "de": "Quellzeitzone (IANA, zum Beispiel Europe/Berlin)",
        "fr": "Fuseau source (IANA, par exemple Europe/Berlin)",
        "es": "Zona horaria origen (IANA, por ejemplo Europe/Berlin)"
      }
    }
  ],
  "actions": [
    {
      "name": "review_products",
      "description": "Inspect source products and exact adapter limitations",
      "handler": "service",
      "permission": "catalog.read",
      "requiredPermissions": [
        "apps.manage"
      ],
      "readOnly": true,
      "mcp": true,
      "flowAllowed": false,
      "inputSchema": {
        "type": "object",
        "properties": {
          "sourceId": {
            "type": "string",
            "maxLength": 100
          },
          "cursor": {
            "type": "string",
            "maxLength": 2000
          }
        },
        "required": [
          "sourceId"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "import_products",
      "description": "Import one explicitly reviewed immutable source page: products",
      "handler": "job",
      "permission": "catalog.write",
      "requiredPermissions": [
        "apps.manage",
        "environments.manage"
      ],
      "mcp": true,
      "readOnly": false,
      "flowAllowed": false,
      "inputSchema": {
        "type": "object",
        "properties": {
          "sourceId": {
            "type": "string",
            "maxLength": 100
          },
          "cursor": {
            "type": "string",
            "maxLength": 2000
          },
          "kind": {
            "type": "string",
            "enum": [
              "products"
            ]
          },
          "target": {
            "type": "string",
            "maxLength": 100
          },
          "recordDigests": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "items": {
              "type": "string",
              "minLength": 64,
              "maxLength": 64
            }
          },
          "options": {
            "type": "object",
            "properties": {
              "channelId": {
                "type": "string",
                "maxLength": 100
              },
              "taxRate": {
                "type": "number",
                "minimum": 0,
                "maximum": 50
              },
              "customerGroup": {
                "type": "string",
                "maxLength": 100
              },
              "locale": {
                "type": "string",
                "maxLength": 35
              },
              "acknowledgedWarnings": {
                "type": "array",
                "maxItems": 20,
                "items": {
                  "type": "string",
                  "maxLength": 200
                }
              }
            },
            "additionalProperties": false
          }
        },
        "required": [
          "sourceId",
          "kind",
          "target",
          "recordDigests",
          "options"
        ],
        "additionalProperties": false
      }
    },
