{
  "id": "algolia",
  "version": "1.0.0",
  "coreApi": "1",
  "runtime": "service",
  "name": {
    "en": "Algolia",
    "de": "Algolia",
    "fr": "Algolia",
    "es": "Algolia"
  },
  "category": "api",
  "presentation": {
    "description": {
      "en": "Send bounded catalogue projections to search. Veyndo still calculates prices, inventory and checkout.",
      "de": "Übertrage begrenzte Katalogdaten zur Suche. Preise, Bestand und Checkout berechnet weiter Veyndo.",
      "fr": "Envoyez le catalogue à la recherche. Veyndo conserve les prix, stocks et commandes.",
      "es": "Envía el catálogo al buscador. Veyndo conserva precios, existencias y compra."
    }
  },
  "permissions": [
    "service.call"
  ],
  "entities": [],
  "slots": [],
  "events": [],
  "actions": [
    {
      "name": "status",
      "description": "Algolia status",
      "handler": "service",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      },
      "public": false,
      "readOnly": true,
      "permission": "apps.manage",
      "mcp": true,
      "outputSchema": {
        "type": "object",
        "properties": {
          "revision": {
            "type": "integer"
          },
          "settings": {
            "type": "object"
          },
          "credentialConfigured": {
            "type": "boolean"
          },
          "jobs": {
            "type": "array",
            "maxItems": 30,
            "items": {
              "type": "object"
            }
          }
        },
        "required": [
          "revision",
          "settings",
          "credentialConfigured",
          "jobs"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "configure",
      "description": "Algolia configure",
      "handler": "service",
      "inputSchema": {
        "type": "object",
        "properties": {
          "revision": {
            "type": "integer",
            "minimum": 0
          },
          "settings": {
            "type": "object",
            "properties": {
              "enabled": {
                "type": "boolean"
              },
              "applicationId": {
                "type": "string",
                "maxLength": 100
              },
              "index": {
                "type": "string",
                "maxLength": 100
              }
            },
            "required": [
              "enabled"
            ],
            "additionalProperties": false
          },
          "credentials": {
            "type": "object",
            "properties": {
              "apiKey": {
                "type": "string",
                "maxLength": 4000
              }
            },
            "required": [],
            "additionalProperties": false
          }
        },
        "required": [
          "revision",
          "settings"
        ],
        "additionalProperties": false
      },
      "public": false,
      "readOnly": false,
      "permission": "apps.manage",
      "mcp": true,
      "outputSchema": {
        "type": "object",
        "properties": {
          "revision": {
            "type": "integer"
          },
          "settings": {
            "type": "object"
          },
          "credentialConfigured": {
            "type": "boolean"
          },
          "jobs": {
            "type": "array",
            "maxItems": 30,
            "items": {
              "type": "object"
            }
          },
          "purgeSources": {
            "type": "boolean"
          },
          "exportCursor": {
            "type": "integer"
          }
        },
        "required": [
          "revision",
          "settings",
          "credentialConfigured",
          "jobs"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "run",
      "description": "Algolia run",
      "handler": "service",
      "inputSchema": {
        "type": "object",
        "properties": {
          "requestKey": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "input": {
            "type": "object",
            "properties": {
              "records": {
                "type": "array",
                "minItems": 1,
                "maxItems": 50,
                "items": {
                  "type": "object"
                }
              }
            },
            "required": [
              "records"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "requestKey",
          "input"
        ],
        "additionalProperties": false
      },
      "public": false,
      "readOnly": false,
      "permission": "apps.manage",
      "mcp": true,
      "flowAllowed": true,
      "requiredPermissions": [
        "catalog.read"
      ],
      "outputSchema": {
        "type": "object",
        "properties": {
          "jobId": {
            "type": "string",
            "maxLength": 200
          },
          "state": {
            "type": "string",
            "enum": [
              "accepted"
            ]
          }
        },
        "required": [
          "jobId",
          "state"
        ],
        "additionalProperties": false
      }
    }
  ]
}
